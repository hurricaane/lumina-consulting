              [
                "title",
                {
                  "__TYPE__": "FieldContent",
                  "type": "Text",
                  "value": "La vitesse n'est pas un détail technique"
                }
              ],
              [
                "body",
                {
                  "__TYPE__": "StructuredTextContent",
                  "value": [
                    {
                      "type": "paragraph",
                      "content": {
                        "text": "C'est la première chose que vos visiteurs ressentent. Un site rapide inspire confiance. Un site lent fait fuir — et chaque seconde de chargement en trop vous coûte des ventes que vous ne verrez jamais.",
                        "spans": []
                      },
                      "direction": "ltr"
                    }
                  ]
                }
              ]
            ]
          },
          {
